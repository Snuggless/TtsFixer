@namespace TtsFixer.WebApp.Pages

@attribute [RouteAttribute(RouteTemplate.Index)]

@inject IRuleRepository RuleRepository
@inject IDialogService DialogService

<PageTitle>TTS Fixer</PageTitle>

<MudStack Class="h-100 py-4 h-100">
    <MudPaper Class="pa-4">
        <MudStack Spacing="2" AlignItems="@AlignItems.Center">
            <MudText Typo="Typo.h4" Class="fw-bold">Text-To-Speach Normalizer</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary px-8 py-4">
                Create and toggle text transformation rules to clean, normalize, and fix pronunciation before text-to-speech output.
            </MudText>
            <MudStack Row="true">
                @if (File is null)
                {
                    <MudFileUpload T="IBrowserFile" Accept="@Accept" MaximumFileCount="1" Files="@File" OnFilesChanged="@OnInputFileChange">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload">
                                Upload
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="@Color.Secondary" Variant="@Variant.Outlined" @onclick="@OnAddClick">
                        Add Rule
                    </MudButton>
                }
                else
                {
                    <MudButton StartIcon="@Icons.Material.Filled.RunCircle" Color="@Color.Success" Variant="@Variant.Filled" OnClick="@OnRunClick">
                        Run
                    </MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Cancel" Color="@Color.Error" Variant="@Variant.Outlined" OnClick="@OnCancelClick">
                        Cancel
                    </MudButton>
                }
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudElement HtmlTag="div" Class="h-100">
        @foreach (var item in CustomRules)
        {
            <MudCard Class="mb-2">
                <MudCardHeader>
                    <MudStack Spacing="1" Justify="Justify.SpaceBetween" Row="true" Style="width: 100% !important">
                        <MudStack Row="false" Spacing="1">
                            <MudText Typo="@Typo.h6">
                                @item.Name
                            </MudText>
                            <MudText Typo="@Typo.body2">
                                @item.Description
                            </MudText>
                        </MudStack>

                        <MudSpacer />

                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Variant="@Variant.Text" Color="@Color.Tertiary" OnClick="@(() => OnEditClick(item))"/>
                    </MudStack>
                </MudCardHeader>

                <MudCardContent>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudStack Row="false" Spacing="1">
                                <MudStack Row="true" Justify="Justify.Center">
                                    <MudText Typo="Typo.body2" Color="Color.Primary">
                                        Pattern
                                    </MudText>
                                </MudStack>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                                    @item.Pattern
                                </MudChip>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudStack Row="false" Spacing="1">
                                <MudStack Row="true" Justify="Justify.Center">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Replacement
                                    </MudText>
                                </MudStack>
                                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">
                                    @item.Replacement
                                </MudChip>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>  

                <MudExpansionPanels Dense="true" Elevation="0" Class="pb-4">
                    <MudExpansionPanel Text="Details">
                        <MudStack Row="false" Spacing="1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Created: @item.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </MudText>
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                Preview: applying this rule will replace occurrences of
                                <MudText Color="Color.Info" Class="mx-1">"@item.Pattern"</MudText>
                                with
                                <MudText Color="Color.Primary" Class="mx-1">"@item.Replacement"</MudText>
                                @(item.UseRegex ? "(regex)" : "(literal)")
                                @(item.CaseSensetive ? ", case-sensitive" : ", case-insensitive")
                            </MudAlert>
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudCard>
        }
    </MudElement>
</MudStack>


@code {
    private const string Accept = ".txt";

    private IBrowserFile? File { get; set; }
    private IEnumerable<CustomRule> CustomRules { get; set; } = [];

    override protected async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        CustomRules = await RuleRepository.GetAsync();
    }

    private void OnInputFileChange(InputFileChangeEventArgs e)
    {
        File = e.File;
        StateHasChanged();
    }

    private void OnCancelClick()
    {
        File = null;
        StateHasChanged();
    }

    private void OnRunClick()
    {
        var content = File!.OpenReadStream();

        using var reader = new StreamReader(content);
        var text = reader.ReadToEnd();
    }

    private async void OnEditClick(CustomRule rule)
    {
        var parameters = new DialogParameters
        {
            { nameof(RuleDialog.Rule), rule }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false,
        };

        var dialog = await DialogService.ShowAsync<RuleDialog>("Add Rule", parameters, options);
        _ = await dialog.Result;
        await RuleRepository.UpdateAsync(rule);
        CustomRules = await RuleRepository.GetAsync();

        StateHasChanged();
    }

    private async void OnAddClick()
    {
        var newRule = new CustomRule { Identifier = Guid.NewGuid() };
        var parameters = new DialogParameters
        {
            { nameof(RuleDialog.Rule), newRule }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false,
        };

        var dialog = await DialogService.ShowAsync<RuleDialog>("Add Rule", parameters, options);
        _ = await dialog.Result;
        await RuleRepository.CreateAsync(newRule);
        CustomRules = await RuleRepository.GetAsync();

        StateHasChanged();
    }
}
